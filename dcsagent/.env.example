# 이 파일을 .env 로 복사한 뒤 실제 값으로 채워서 docker-compose.yml 과 같은 폴더에 두세요.
# DCSServer 가 이 서버의 DCSAgent 를 호출할 때 사용하는 공유 비밀키. DCSServer 쪽 AGENT_API_KEY 와 반드시 동일해야 합니다.
AGENT_API_KEY=changeme
# 이 에이전트가 상태를 보고할 DCSServer 의 실제 도달 가능한 주소 (다른 물리 서버일 수 있으므로 IP/도메인 사용)
DCSSERVER_URL=https://100.125.13.91:8444
# keystore.p12 를 생성할 때 지정한 비밀번호
SSL_KEYSTORE_PASSWORD=changeme
