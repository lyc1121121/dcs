version: "3.9"
services:
  tmoneydcs:
    image: dcsregistry:5000/tmoneydcs:${DCS_IMAGE_VERSION}
    container_name: dcs${DCS_ID}
    hostname: dcs${DCS_ID}
    environment:
      - DCS_ID=${DCS_DOT_ID}
      - DCS_MODE=${DCS_MODE}
      - TZ=Asia/Seoul
      - LANG=ko_KR.UTF-8
      - DCS_SIZE=${DCS_SIZE}
    user: 5000:5000
    volumes:
      - /data001/dcs${DCS_ID}/data001/:/data001/:Z
      - /data001/dcs${DCS_ID}/ssc/:/ssc/:Z
      - /logs001/dcs${DCS_ID}/:/logs001/:Z
    ports:
      - "${PORT_DCS1}:20000"
      - "${PORT_DCS2}:30000"
    security_opt:
      - label:disable
    restart: always
  eaiagent:
    image: dcsregistry:5000/eaiagent:latest
    container_name: eaiagent_${DCS_ID}
    hostname: eaiagent_${DCS_ID}
    environment:
      - DCS_ID=${DCS_ID}
      - EAI_SERVER_HOST=${EAI_SERVER_HOST}
      # 컨테이너 안에서는 ssc 가 /ssc 에 그대로 마운트되므로(호스트 경로의 dcs${DCS_ID} 부분이 없음),
      # 기본값(EAI_SND_DIR/RCV_DIR 의 /data001/dcs${DCS_ID}/... 형태)을 쓰지 않고 명시적으로 지정한다.
      - EAI_SND_DIR=/ssc/APP/SND/SCFZ
      - EAI_RCV_DIR=/ssc/APP/RCV
    volumes:
      - /data001/dcs${DCS_ID}/ssc/:/ssc/:Z
    security_opt:
      - label:disable
    restart: always
