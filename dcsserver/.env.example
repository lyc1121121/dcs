# 이 파일을 .env 로 복사한 뒤 실제 값으로 채워서 docker-compose.yml 과 같은 폴더에 두세요.
DB_PASSWORD=changeme
# 모든 DCSAgent 와 공유하는 비밀키 (DCSAgent 의 AGENT_API_KEY 와 동일해야 함)
AGENT_API_KEY=changeme
# DCSManager 가 이 DCSServer 를 호출할 때 사용할 비밀키 (DCSManager 쪽 설정과 동일해야 함)
SERVER_API_KEY=changeme
# keystore.p12 를 생성할 때 지정한 비밀번호
SSL_KEYSTORE_PASSWORD=changeme
